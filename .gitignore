.nextflow*
work/
data/
results/
.DS_Store
testing/
testing*
*.pyc
null/
.lineage/
.nf-test/
.nf-test.log

# keep updates to .gitignore below to prevent linting error
.nf-test-*.nf
stub/results/
# synthetic test data from scripts/generate_test_data.py:
# track the small metadata files, but not the profiles (to be hosted externally)
!tests/data/
tests/data/**/*.parquet

.claude/settings.local.json

# local issue tracker for agent skills
.scratch/

# upstream PCCMA metadata copied by assets/pccma/scripts/build_source.py:
# track only the provenance README (license notices are in assets/pccma/README.md)
assets/pccma/source/*
!assets/pccma/source/README.md

# PCCMA platemaps built from source/ by assets/pccma/scripts/build_platemaps.py
assets/pccma/platemaps/
