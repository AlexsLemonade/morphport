nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"

    test("-profile test -stub") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
                // Rewrite stub/samplesheet.csv's plate_dir/platemaps_dir/platemap_file columns
                // to absolute paths: nf-test runs pipeline tests in an isolated launch directory,
                // so the samplesheet's paths (relative to the repo root) would not otherwise resolve.
                def stub_dir = new File("$projectDir/stub")
                def rows = new File(stub_dir, 'samplesheet.csv').readLines()
                def header = rows[0].split(',') as List
                def path_cols = ['plate_dir', 'platemaps_dir', 'platemap_file']
                def rewritten = [rows[0]] + rows[1..-1].collect { line ->
                    def vals = line.split(',', -1)
                    header.eachWithIndex { col, i ->
                        if (col in path_cols && vals[i]) {
                            vals[i] = new File(stub_dir.parentFile, vals[i]).path
                        }
                    }
                    vals.join(',')
                }
                def tmp_csv = new File(File.createTempDir('nf-test-samplesheet-'), 'samplesheet.csv')
                tmp_csv.text = rewritten.join('\n') + '\n'
                input = tmp_csv.path
                analysis_groups_file = "$projectDir/stub/analysis_groups.yml"
            }
        }

        then {
            // stable_path: All files + folders in ${params.outdir}/ with a stable path (including file name)
            def stable_path = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            // stable_content: All files in ${params.outdir}/ with stable content
            def stable_content = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assert workflow.success
            assertAll(
                { assert snapshot(
                    // pipeline versions.yml file from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/morphport_software_versions.yml"),
                    // All stable path name, with a relative path
                    stable_path,
                    // All files with stable contents
                    stable_content
                ).match() }
            )
        }
    }
}
