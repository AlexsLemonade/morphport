nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"

    test("-profile test") {

        when {
            params {
                outdir = "$outputDir"
                // minimal synthetic data from scripts/generate_test_data.py (see tests/data/README.md)
                input = TestSamplesheet.withAbsolutePaths("$projectDir/tests/data/samplesheet_minimal.csv", "$projectDir", "$launchDir")
            }
        }

        then {
            // stable_path: All files + folders in ${params.outdir}/ with a stable path (including file name)
            // File contents are not snapshotted: numeric results (normalization, embeddings, clustering)
            // can vary slightly across platforms and container engines.
            def stable_path = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            // Embedding and clustering summaries: 3 per group, for the 4 groups in tests/data/analysis_groups_minimal.yml
            // (neuroblastoma at both aggregate levels, u2os_anchor at the cell level, all_cell_lines at the well level)
            def analysis_summaries = getAllFilesFromDir(params.outdir, include: ['**/embeddings_summary_*.json', '**/clustering_*_summary_*.json'])
            assert workflow.success
            assertAll(
                // every group has enough data to be embedded and clustered, so none are skipped
                { assert analysis_summaries.size() == 12 },
                { analysis_summaries.each { summary -> assert !path(summary.toString()).json.skipped : "${summary.name} was skipped" } },
                { assert snapshot(
                    // pipeline versions.yml file from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/morphport_software_versions.yml"),
                    // All stable path name, with a relative path
                    stable_path
                ).match() }
            )
        }
    }

    test("-profile test -stub") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
                input = TestSamplesheet.withAbsolutePaths("$projectDir/stub/samplesheet.csv", "$projectDir", "$launchDir")
                analysis_groups_file = "$projectDir/stub/analysis_groups.yml"
                // the test profile only runs with edge wells excluded; run both edge-well variants here
                edge_well_filter = 'both'
            }
        }

        then {
            // stable_path: All files + folders in ${params.outdir}/ with a stable path (including file name)
            def stable_path = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            // stable_content: All files in ${params.outdir}/ with stable content
            def stable_content = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assert workflow.success
            assertAll(
                { assert snapshot(
                    // pipeline versions.yml file from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/morphport_software_versions.yml"),
                    // All stable path name, with a relative path
                    stable_path,
                    // All files with stable contents
                    stable_content
                ).match() }
            )
        }
    }
}
