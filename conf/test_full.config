/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a full size pipeline test.

    Use as follows:
        nextflow run AlexsLemonade/morphport -profile test_full,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

// NOT YET IMPLEMENTED: this profile is reserved for a full-size test on real data,
// read from the Cell Painting Gallery (CPG), once suitable PCCMA data are available there.
// It is not run by any test or CI workflow.
// For a quick test on synthetic data, use the `test` profile (conf/test.config).

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'Full-size test on real data (not yet implemented)'
}
