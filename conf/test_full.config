/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a full size pipeline test.

    Use as follows:
        nextflow run AlexsLemonade/morphport -profile test_full,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'Full-size test on simulated PCCMA atlas data'

    // Input data
    // Simulated profiles for the PCCMA atlas plates in tests/data-full/ (3 plates, 14 cell lines at 24, 48, and 72 h);
    // the parquet profiles and platemaps are not tracked by git and must be generated first with
    // `uv run scripts/generate_full_test_data.py` (see tests/data-full/README.md).
    // Samplesheet paths are relative to the repo root, so launch the pipeline from there.
    input                = "${projectDir}/tests/data-full/atlas_samplesheet.csv"
    analysis_groups_file = "${projectDir}/tests/data-full/atlas_analysis_groups.yml"

    // The simulated features use the PCCMA channel names (e.g. DNA rather than CorrDNA)
    cosmicqc_filter_file = "${projectDir}/assets/cosmicqc_filter_settings_pccma.json"
}
