/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests on a compound screen
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a full size pipeline test
    on compound screen data.

    Use as follows:
        nextflow run AlexsLemonade/morphport -profile test_full_screen,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Full screen test profile'
    config_profile_description = 'Full-size test on simulated PCCMA REPO1 compound screen data'

    // Input data
    // Simulated profiles for the PCCMA REPO1 screen plates in tests/data-full/
    // (12 plates: 2 layouts x 3 replicates, for SK-N-AS and simulated U2-OS);
    // the parquet profiles and platemaps are not tracked by git and must be generated first with
    // `uv run scripts/generate_full_test_data.py` (see tests/data-full/README.md).
    // Samplesheet paths are relative to the repo root, so launch the pipeline from there.
    input                = "${projectDir}/tests/data-full/screen_samplesheet.csv"
    analysis_groups_file = "${projectDir}/tests/data-full/screen_analysis_groups.yml"

    // The simulated features use the PCCMA channel names (e.g. DNA rather than CorrDNA)
    cosmicqc_filter_file = "${projectDir}/assets/cosmicqc_filter_settings_pccma.json"
}
