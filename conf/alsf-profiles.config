// ALSF-specific profiles
profiles {
  // AWS batch settings
  batch {
    includeConfig 'aws-batch.config'
  }

  alsf_testing {
    params {
      config_profile_name        = 'ALSF testing profile'
      config_profile_description = 'ALSF testing profile for morphport'
      outdir                     = 's3://morphport-nf-results-testing/results'
    }
    outputDir = params.outdir

    tower {
      enabled         = true
      workspaceId     = '195694958660569'
      reports.enabled = false
    }
  }

  alsf_prod {
    params {
      config_profile_name        = 'ALSF production profile'
      config_profile_description = 'ALSF production profile for morphport'
      outdir                     = 's3://morphport-nf-results-prod/results'
    }
    outputDir = params.outdir

    tower {
      enabled         = true
      workspaceId     = '195694958660569'
      reports.enabled = false
    }
  }
}
