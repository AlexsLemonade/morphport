/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run AlexsLemonade/morphport -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 2,
        memory: '7.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Input data
    // Synthetic data in tests/data/; the parquet profiles are not tracked by git and must be
    // generated first with `uv run scripts/generate_test_data.py` (see tests/data/README.md).
    // Samplesheet paths are relative to the repo root, so launch the pipeline from there.
    input                = "${projectDir}/tests/data/samplesheet.csv"
    analysis_groups_file = "${projectDir}/tests/data/analysis_groups.yml"
}
