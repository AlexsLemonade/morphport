/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run AlexsLemonade/morphport -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 2,
        memory: '7.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Input data
    // Real minimal `test`-profile data for morphport is not yet available on the
    // nf-core/test-datasets `morphport` branch (see params.pipelines_testdata_base_path
    // in tests/nextflow.config). Until then, this profile reuses the in-repo stub/
    // dataset, which contains only empty placeholder files and so is only runnable
    // with `-stub` (see conf/stub.config and stub/README.md).
    // Regenerate the tests/default.nf.test snapshot once real data replaces this.
    input                = "${projectDir}/stub/samplesheet.csv"
    analysis_groups_file = "${projectDir}/stub/analysis_groups.yml"
}
