/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
Available keys to override module options:
ext.args   = Additional arguments appended to command in module.
ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
ext.prefix = File name prefix for output files.
ext.publish_dir = Name of the tool directory outputs are published to
(default: the first word of the process name, e.g. 'cosmicqc' for COSMICQC_FILTER).
----------------------------------------------------------------------------------------
 */

process {

    // Outputs are published to <outdir>/<project>/<aggregate_level>/<tool_dir>/
    publishDir = [
        path: {
            def tool_dir = task.ext.publish_dir ?: task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()
            "${params.outdir}/${meta.project}/${meta.aggregate_level}/${tool_dir}"
        },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
    ]

    withLabel: publish_optional {
        publishDir = [
            path: {
                def tool_dir = task.ext.publish_dir ?: task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()
                "${params.outdir}/${meta.project}/${meta.aggregate_level}/${tool_dir}"
            },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            enabled: params.publish_optional,
        ]
    }

    // Use for processes that pass unmodified parquets through to their outputs (e.g., feature selection)
    withLabel: publish_skip_parquet {
        publishDir = [
            path: {
                def tool_dir = task.ext.publish_dir ?: task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()
                "${params.outdir}/${meta.project}/${meta.aggregate_level}/${tool_dir}"
            },
            mode: params.publish_dir_mode,
            saveAs: { filename -> (filename.equals('versions.yml') || filename.endsWith('.parquet')) ? null : filename },
        ]
    }

    // Override the default tool directory where the first word of the process name is not descriptive
    withName: COMPUTE_EMBEDDINGS {
        ext.publish_dir = 'embeddings'
    }

    withName: 'HIERARCHICAL_CLUSTERING_.*' {
        ext.publish_dir = 'hierarchical_clustering'
    }

    withName: PYCYTOMINER_REFERENCE_NORMALIZE {
        ext.publish_dir = 'reference_normalization'
    }

    withName: PHENOTYPIC_ACTIVITY {
        ext.publish_dir = 'phenotypic_activity'
    }
}
