    test("validateGroupingsAgainstData: always_include values missing from a subgroup are an error") {

        function "validateGroupingsAgainstData"

        when {
            function {
                """
                def combo = { treatment, cell_type ->
                    [Metadata_treatment: treatment, Metadata_cell_type: cell_type, project: 'demo', plate_id: 'p1']
                }
                input[0] = [
                    cell: [
                        [
                            name: 'by_line',
                            grouping_column: 'Metadata_treatment',
                            groups: 'one_per_value',
                            always_include: ['DMSO'],
                            excluded: [],
                            filter: [:],
                            subgroup_columns: ['Metadata_cell_type'],
                        ],
                    ],
                    well: [],
                ]
                input[1] = [
                    combo.call('DMSO', 'lineA'),
                    combo.call('drugA', 'lineA'),
                    combo.call('drugA', 'lineB'),
                ]
                """
            }
        }

        then {
            assert function.success
            assert function.result.size() == 1
            assert function.result[0].contains("'by_line'")
