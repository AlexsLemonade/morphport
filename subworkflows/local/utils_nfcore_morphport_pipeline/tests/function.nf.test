nextflow_function {

    name "Test morphport pipeline utility functions"
    script "../main.nf"
    tag "subworkflows"
    tag "subworkflows_local"
    tag "utils_nfcore_morphport_pipeline"

    //
    // parsePlatemapColumns
    //

    test("parsePlatemapColumns: quoted headers are unquoted, prefixed, and exclude the well column") {

        function "parsePlatemapColumns"

        when {
            function {
                """
                def platemap = new File(File.createTempDir('platemaps-'), 'quoted.txt')
                platemap.text = '\\uFEFF"well_position"\\t"treatment"\\tdose\\nA01\\t"drugA"\\t1\\nA02\\tdrugA\\t1\\nA03\\t"drug\\tB"\\t2\\nA04\\t5" plate\\t\\n\\nA05\\t  DMSO  \\t0\\n'
                input[0] = platemap.path
                input[1] = 'well_position'
                input[2] = ['Metadata_treatment', 'Metadata_extra']
                """
            }
        }

        then {
            assert function.success
            assert function.result == ['Metadata_treatment', 'Metadata_dose', 'Metadata_extra']
        }
    }

    test("parsePlatemapColumns: a blank first row does not affect the columns") {

        function "parsePlatemapColumns"

        when {
            function {
                """
                def platemap = new File(File.createTempDir('platemaps-'), 'blank_first_row.txt')
                platemap.text = 'well_position\\ttreatment\\tdose\\n\\t \\t\\nA01\\tdrugA\\n'
                input[0] = platemap.path
                input[1] = 'well_position'
                """
            }
        }

        then {
            assert function.success
            assert function.result == ['Metadata_treatment', 'Metadata_dose']
        }
    }

    test("parsePlatemapColumns: a missing well column is an error") {

        function "parsePlatemapColumns"

        when {
            function {
                """
                def platemap = new File(File.createTempDir('platemaps-'), 'no_well.txt')
                platemap.text = 'well\\ttreatment\\nA01\\tdrugA\\n'
                input[0] = platemap.path
                input[1] = 'well_position'
                """
            }
        }

        then {
            assert function.failed
            def output = (function.stdout + function.stderr).join('\n')
            assert output.contains("missing the well column 'well_position'")
        }
    }

    //
    // resolvePlatemapFromDir
    //

    test("resolvePlatemapFromDir: finds a .csv platemap") {

        function "resolvePlatemapFromDir"

        when {
            function {
                """
                def base = File.createTempDir('platemaps-')
                new File(base, 'batch1/platemap').mkdirs()
                new File(base, 'batch1/barcode_platemap.csv').text = 'Assay_Plate_Barcode,Plate_Map_Name\\nplate1,layout1\\n'
                new File(base, 'batch1/platemap/layout1.csv').text = 'well,cell_line\\nC03,DAOY\\n'
                input[0] = 'plate1'
                input[1] = 'batch1'
                input[2] = base.path
                """
            }
        }

        then {
            assert function.success
            assert function.result.endsWith('/batch1/platemap/layout1.csv')
        }
    }

    test("resolvePlatemapFromDir: platemaps with the same name and different extensions are an error") {

        function "resolvePlatemapFromDir"

        when {
            function {
                """
                def base = File.createTempDir('platemaps-')
                new File(base, 'batch1/platemap').mkdirs()
                new File(base, 'batch1/barcode_platemap.csv').text = 'Assay_Plate_Barcode,Plate_Map_Name\\nplate1,layout1\\n'
                new File(base, 'batch1/platemap/layout1.csv').text = 'well,cell_line\\nC03,DAOY\\n'
                new File(base, 'batch1/platemap/layout1.txt').text = 'well\\tcell_line\\nC03\\tDAOY\\n'
                input[0] = 'plate1'
                input[1] = 'batch1'
                input[2] = base.path
                """
            }
        }

        then {
            assert function.failed
            def output = (function.stdout + function.stderr).join('\n')
            assert output.contains("multiple platemap files found for 'layout1'")
        }
    }
}
