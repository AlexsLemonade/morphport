nextflow_process {

    name "Test Process HIERARCHICAL_CLUSTERING_PROFILES"
    script "../main.nf"
    process "HIERARCHICAL_CLUSTERING_PROFILES"
    tag "modules"
    tag "modules_local"
    tag "hierarchical_clustering_profiles"

    // Fixtures in tests/fixtures are written by tests/fixtures/generate_fixtures.py (see its docstring):
    // 12 wells over two plates, with one all-NaN row (P1 A05), one row with a single NaN (P1 A06),
    // and one constant row (P2 A01); and 8 rows of PCA embeddings.

    // Shared group metadata, interpolated into each test's input as Groovy source text.
    // Tests that need different values add them with `+ [key: value]`.
    def groupMeta = """[
        project: 'test', aggregate_level: 'well', grouping_name: 'by_cell_line',
        grouping_column: 'Metadata_cell_line', group: 'U2-OS', subgroup_values: [:],
        group_id: 'cell_line=U2-OS', group_tag: 'well__by_cell_line__cell_line=U2-OS', plate_ids: ['P1', 'P2'],
    ]"""

    test("features input - euclidean") {

        when {
            process {
                """
                input[0] = [
                    ${groupMeta} + [
                        subgroup_values: [Metadata_timepoint: '24h'],
                        group_id: 'cell_line=U2-OS__timepoint=24h',
                        group_tag: 'well__by_cell_line__cell_line=U2-OS__timepoint=24h',
                    ],
                    [file("${moduleDir}/tests/fixtures/profiles_nan_rows.parquet"), file("${moduleDir}/tests/fixtures/profiles_constant_row.parquet")],
                    file("${moduleDir}/tests/fixtures/features.txt"),
                    [],
                ]
                input[1] = 'euclidean'
                input[2] = 0.5
                input[3] = 100
                """
            }
        }

        then {
            assert process.success
            def (meta, linkage, leaves, summary) = process.out.result[0]
            assert meta.group_tag == 'well__by_cell_line__cell_line=U2-OS__timepoint=24h'
            assert path(summary).json == [
                group_tag: 'well__by_cell_line__cell_line=U2-OS__timepoint=24h',
                aggregate_level: 'well',
                grouping_name: 'by_cell_line',
                grouping_column: 'Metadata_cell_line',
                group: 'U2-OS',
                subgroup_values: [Metadata_timepoint: '24h'],
                input: 'features',
                method: 'ward',
                metric: 'euclidean',
                max_nan_fraction: 0.5,
                n_columns: 4,
                n_rows_input: 12,
                n_rows_dropped_nan: 1,
                n_rows_nan_filled: 1,
                n_profiles: 11,
                n_profiles_zero_length: 0,
            ]
            with(path(linkage).parquet) {
                assert rowCount == 10
                assert schema == [left: Long, right: Long, distance: Double, n_members: Long]
                // the last merge joins all profiles
                assert rows[-1][3] == 11
                // node ids are 0..(2n - 2), each merged once, except the root
                assert rows.collectMany { row -> [row[0], row[1]] }.sort() == (0..<20).toList()
            }
            with(path(leaves).parquet) {
                assert rowCount == 11
                // grouping column, then subgroup columns, then the ID columns present in the input
                assert schema == [
                    leaf_id: Long, leaf_order: Long, label: String,
                    Metadata_cell_line: String, Metadata_timepoint: String, Metadata_Plate: String, Metadata_Well: String,
                ]
                assert rows.collect { row -> row[0] } == (0..<11).toList()
                assert rows.collect { row -> row[1] }.sort() == (0..<11).toList()
                // rows in input order, without the dropped all-NaN row (P1 A05)
                assert rows.collect { row -> row[2] } == [
                    'P1_A01', 'P1_A02', 'P1_A03', 'P1_A04', 'P1_A06',
                    'P2_A01', 'P2_A02', 'P2_A03', 'P2_A04', 'P2_A05', 'P2_A06',
                ]
                assert rows.every { row -> row[3] == 'U2-OS' && row[4] == '24h' }
            }
            def versions = path(process.out.versions[0]).yaml
            assert versions['HIERARCHICAL_CLUSTERING_PROFILES'].keySet() == ['python', 'polars', 'numpy', 'scipy', 'fastcluster'] as Set
        }
    }

    test("features input - correlation") {

        when {
            process {
                """
                input[0] = [
                    ${groupMeta},
                    [file("${moduleDir}/tests/fixtures/profiles_nan_rows.parquet"), file("${moduleDir}/tests/fixtures/profiles_constant_row.parquet")],
                    file("${moduleDir}/tests/fixtures/features.txt"),
                    [],
                ]
                input[1] = 'correlation'
                input[2] = 0.5
                input[3] = 100
                """
            }
        }

        then {
            assert process.success
            def (_meta, linkage, leaves, summary) = process.out.result[0]
            with(path(summary).json) {
                assert metric == 'correlation'
                assert n_profiles == 11
                // the constant row (P2 A01) has zero length after centering
                assert n_profiles_zero_length == 1
                assert !containsKey('skipped')
            }
            with(path(linkage).parquet) {
                assert rowCount == 10
                assert rows[-1][3] == 11
            }
            with(path(leaves).parquet) {
                assert rowCount == 11
                // no subgroup columns
                assert columnNames == ['leaf_id', 'leaf_order', 'label', 'Metadata_cell_line', 'Metadata_Plate', 'Metadata_Well']
            }
        }
    }

    test("features input - cosine") {

        when {
            process {
                """
                input[0] = [
                    ${groupMeta},
                    [file("${moduleDir}/tests/fixtures/profiles_nan_rows.parquet"), file("${moduleDir}/tests/fixtures/profiles_constant_row.parquet")],
                    file("${moduleDir}/tests/fixtures/features.txt"),
                    [],
                ]
                input[1] = 'cosine'
                input[2] = 0.5
                input[3] = 100
                """
            }
        }

        then {
            assert process.success
            def (_meta, linkage, leaves, summary) = process.out.result[0]
            with(path(summary).json) {
                assert metric == 'cosine'
                assert n_profiles == 11
                // the constant row is not centered for cosine, so it has nonzero length
                assert n_profiles_zero_length == 0
            }
            assert path(linkage).parquet.rowCount == 10
            assert path(leaves).parquet.rowCount == 11
        }
    }

    test("features input - max_nan_fraction 0 drops all rows with NaNs") {

        when {
            process {
                """
                input[0] = [
                    ${groupMeta},
                    [file("${moduleDir}/tests/fixtures/profiles_nan_rows.parquet"), file("${moduleDir}/tests/fixtures/profiles_constant_row.parquet")],
                    file("${moduleDir}/tests/fixtures/features.txt"),
                    [],
                ]
                input[1] = 'euclidean'
                input[2] = 0
                input[3] = 100
                """
            }
        }

        then {
            assert process.success
            def (_meta, linkage, leaves, summary) = process.out.result[0]
            with(path(summary).json) {
                assert max_nan_fraction == 0.0
                assert n_rows_input == 12
                assert n_rows_dropped_nan == 2
                assert n_rows_nan_filled == 0
                assert n_profiles == 10
            }
            assert path(linkage).parquet.rowCount == 9
            with(path(leaves).parquet) {
                assert rowCount == 10
                assert !rows.collect { row -> row[2] }.any { label -> label in ['P1_A05', 'P1_A06'] }
            }
        }
    }

    test("pcs input") {

        when {
            process {
                """
                input[0] = [
                    ${groupMeta},
                    [file("${moduleDir}/tests/fixtures/embeddings.parquet")],
                    [],
                    file("${moduleDir}/tests/fixtures/embeddings_summary.json"),
                ]
                input[1] = 'euclidean'
                input[2] = 0.5
                input[3] = 100
                """
            }
        }

        then {
            assert process.success
            def (_meta, linkage, leaves, summary) = process.out.result[0]
            with(path(summary).json) {
                assert input == 'pcs'
                // PC1..PC3, not UMAP1 or UMAP2
                assert n_columns == 3
                assert n_rows_input == 8
                assert n_rows_dropped_nan == 0
                assert n_rows_nan_filled == 0
                assert n_profiles == 8
                assert !containsKey('skipped')
            }
            with(path(linkage).parquet) {
                assert rowCount == 7
                assert rows[-1][3] == 8
            }
            with(path(leaves).parquet) {
                assert rowCount == 8
                assert columnNames == ['leaf_id', 'leaf_order', 'label', 'Metadata_cell_line', 'Metadata_Plate', 'Metadata_Well']
                assert rows.collect { row -> row[2] } == [
                    'P1_A01', 'P1_A02', 'P1_A03', 'P1_A04',
                    'P2_A01', 'P2_A02', 'P2_A03', 'P2_A04',
                ]
            }
        }
    }

    test("skip - upstream embeddings skipped") {

        when {
            process {
                """
                input[0] = [
                    ${groupMeta},
                    [file("${moduleDir}/tests/fixtures/embeddings.parquet")],
                    [],
                    file("${moduleDir}/tests/fixtures/embeddings_summary_skipped.json"),
                ]
                input[1] = 'euclidean'
                input[2] = 0.5
                input[3] = 100
                """
            }
        }

        then {
            assert process.success
            def (_meta, linkage, leaves, summary) = process.out.result[0]
            with(path(summary).json) {
                assert input == 'pcs'
                assert skipped == true
                assert skip_reason == 'upstream compute_embeddings skipped this group: n_rows (8) < embedding_min_rows (10)'
            }
            with(path(linkage).parquet) {
                assert rowCount == 0
                assert schema == [left: Long, right: Long, distance: Double, n_members: Long]
            }
            with(path(leaves).parquet) {
                assert rowCount == 0
                assert schema == [leaf_id: Long, leaf_order: Long, label: String]
            }
        }
    }

    test("skip - no PC columns") {

        when {
            process {
                """
                // feature-selected profiles without a features file, so PC columns are expected
                input[0] = [
                    ${groupMeta},
                    [file("${moduleDir}/tests/fixtures/profiles_nan_rows.parquet")],
                    [],
                    [],
                ]
                input[1] = 'euclidean'
                input[2] = 0.5
                input[3] = 100
                """
            }
        }

        then {
            assert process.success
            def (_meta, linkage, leaves, summary) = process.out.result[0]
            with(path(summary).json) {
                assert input == 'pcs'
                assert skipped == true
                assert skip_reason == 'no PCA columns found in the embeddings parquet'
            }
            assert path(linkage).parquet.rowCount == 0
            assert path(leaves).parquet.rowCount == 0
        }
    }

    test("skip - more profiles than max_profiles") {

        when {
            process {
                """
                input[0] = [
                    ${groupMeta},
                    [file("${moduleDir}/tests/fixtures/profiles_nan_rows.parquet"), file("${moduleDir}/tests/fixtures/profiles_constant_row.parquet")],
                    file("${moduleDir}/tests/fixtures/features.txt"),
                    [],
                ]
                input[1] = 'euclidean'
                input[2] = 0.5
                input[3] = 10
                """
            }
        }

        then {
            assert process.success
            def (_meta, linkage, leaves, summary) = process.out.result[0]
            with(path(summary).json) {
                // rows are counted (after NaN filtering) before skipping
                assert n_rows_input == 12
                assert n_profiles == 11
                assert skipped == true
                assert skip_reason == 'n_profiles (11) > clustering_max_profiles (10)'
            }
            with(path(linkage).parquet) {
                assert rowCount == 0
                assert schema == [left: Long, right: Long, distance: Double, n_members: Long]
            }
            with(path(leaves).parquet) {
                assert rowCount == 0
                assert schema == [leaf_id: Long, leaf_order: Long, label: String]
            }
        }
    }

    test("features input - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    ${groupMeta},
                    [file("${moduleDir}/tests/fixtures/profiles_nan_rows.parquet"), file("${moduleDir}/tests/fixtures/profiles_constant_row.parquet")],
                    file("${moduleDir}/tests/fixtures/features.txt"),
                    [],
                ]
                input[1] = 'euclidean'
                input[2] = 0.5
                input[3] = 100
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }
}
