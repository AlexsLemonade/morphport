{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/AlexsLemonade/morphport/main/assets/schema_input.json",
    "title": "AlexsLemonade/morphport pipeline - params.input schema",
    "description": "Schema for the file provided with params.input",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "plate": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Plate ID must be provided and cannot contain spaces",
                "meta": ["plate_id"]
            },
            "project": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Project name must be provided and cannot contain spaces",
                "meta": ["project"]
            },
            "source": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Source name must be provided and cannot contain spaces",
                "meta": ["source"]
            },
            "batch": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Batch name must be provided and cannot contain spaces",
                "meta": ["batch"]
            },
            "sqlite_path": {
                "type": "string",
                "format": "file-path",
                "pattern": "^[^\\s*?]+\\.sqlite$",
                "errorMessage": "SQLite path must be a single file path ending in '.sqlite' and cannot contain spaces or wildcards",
                "meta": ["sqlite_path"]
            },
            "parquet_path": {
                "type": "string",
                "pattern": "^\\S+\\.parquet$",
                "errorMessage": "Parquet path must be a path or glob ending in '.parquet' and cannot contain spaces",
                "meta": ["parquet_path"]
            },
            "platemap_file": {
                "type": "string",
                "format": "file-path",
                "errorMessage": "Platemap file must be a valid file path",
                "meta": ["platemap_file"]
            },
            "platemaps_dir": {
                "type": "string",
                "format": "directory-path",
                "errorMessage": "Platemaps directory must be a valid directory path",
                "meta": ["platemaps_dir"]
            },
            "cytotable_preset": {
                "type": "string",
                "enum": [
                    "cellprofiler_sqlite",
                    "cellprofiler_sqlite_cpg0016_jump",
                    "cellprofiler_sqlite_pycytominer",
                    "skip"
                ],
                "meta": ["cytotable_preset"],
                "default": "cellprofiler_sqlite_cpg0016_jump"
            }
        },
        "required": ["plate", "project", "source", "batch"]
    }
}
