{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/AlexsLemonade/pccma-nf/main/assets/schema_input.json",
    "title": "AlexsLemonade/pccma-nf pipeline - params.input schema",
    "description": "Schema for the file provided with params.input",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "plate": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Plate ID must be provided and cannot contain spaces",
                "meta": ["plate_id"]
            },
            "project": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Project name must be provided and cannot contain spaces",
                "meta": ["project"]
            },
            "source": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Source name must be provided and cannot contain spaces",
                "meta": ["source"]
            },
            "batch": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Batch name must be provided and cannot contain spaces",
                "meta": ["batch"]
            },
            "platemap": {
                "type": "string",
                "meta": ["platemap"]
            },
            "cytotable_preset": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "CytoTable preset name cannot contain spaces",
                "meta": ["cytotable_preset"],
                "default": "cellprofiler_sqlite_cpg0016_jump"
            }
        },
        "required": ["plate", "project", "source", "batch"]
    }
}
