nextflow_function {

    name "Test Function groupingInfoJson"
    script "../morphport_utils.nf"
    tag "lib"

    test("groupingInfoJson: no analysis groups file and no extra") {

        function "groupingInfoJson"

        when {
            function {
                """
                input[0] = [
                    aggregate_level: 'well',
                    grouping_name: 'all',
                    grouping_column: null,
                    group: 'all_values',
                    subgroup_values: [:],
                    group_id: 'all',
                ]
                """
            }
        }

        then {
            assert function.success
            assert function.result == '{"grouping_name":"all","grouping_column":null,"group":"all_values","subgroup_values":{}}'
        }
    }

    test("groupingInfoJson: group identity fields are collected") {

        function "groupingInfoJson"

        when {
            function {
                """
                input[0] = [
                    aggregate_level: 'cell',
                    grouping_name: 'moa_by_cell_line',
                    grouping_column: 'Metadata_treatment',
                    group: 'kinase_inhibitor',
                    subgroup_values: [Metadata_cell_type: 'lineA'],
                    group_id: 'treatment=kinase_inhibitor__cell_type=lineA',
                    project: 'demo',
                ]
                """
            }
        }

        then {
            assert function.success
            assert function.result == '{"grouping_name":"moa_by_cell_line","grouping_column":"Metadata_treatment","group":"kinase_inhibitor","subgroup_values":{"Metadata_cell_type":"lineA"}}'
        }
    }

    test("groupingInfoJson: extra keys are merged in after the identity fields") {

        function "groupingInfoJson"

        when {
            function {
                """
                input[0] = [
                    aggregate_level: 'cell',
                    grouping_name: 'moa',
                    grouping_column: 'Metadata_treatment',
                    group: 'drugA',
                    subgroup_values: [:],
                    group_id: 'treatment=drugA',
                ]
                input[1] = [plate_ids: ['p1', 'p2']]
                """
            }
        }

        then {
            assert function.success
            assert function.result == '{"grouping_name":"moa","grouping_column":"Metadata_treatment","group":"drugA","subgroup_values":{},"plate_ids":["p1","p2"]}'
        }
    }
}
