nextflow_function {

    name "Test Function groupTag"
    script "../morphport_utils.nf"
    tag "lib"

    test("groupTag: no grouping columns falls back to 'all'") {

        function "groupTag"

        when {
            function {
                """
                input[0] = [aggregate_level: 'well']
                """
            }
        }

        then {
            assert function.success
            assert function.result == 'well__all'
        }
    }

    test("groupTag: single grouping column strips the Metadata_ prefix") {

        function "groupTag"

        when {
            function {
                """
                input[0] = [
                    aggregate_level: 'cell',
                    grouping_columns: ['Metadata_treatment'],
                    Metadata_treatment: 'drugA',
                ]
                """
            }
        }

        then {
            assert function.success
            assert function.result == 'cell__treatment=drugA'
        }
    }

    test("groupTag: multiple grouping columns are joined in order") {

        function "groupTag"

        when {
            function {
                """
                input[0] = [
                    aggregate_level: 'cell',
                    grouping_columns: ['Metadata_gene_allele', 'Metadata_treatment'],
                    Metadata_gene_allele: 'BRCA1',
                    Metadata_treatment: 'drugA',
                ]
                """
            }
        }

        then {
            assert function.success
            assert function.result == 'cell__gene_allele=BRCA1__treatment=drugA'
        }
    }

    test("groupTag: characters outside [A-Za-z0-9._=-] are sanitized to underscores") {

        function "groupTag"

        when {
            function {
                """
                input[0] = [
                    aggregate_level: 'cell',
                    grouping_columns: ['Metadata_treatment'],
                    Metadata_treatment: 'drug A/B,control',
                ]
                """
            }
        }

        then {
            assert function.success
            assert function.result == 'cell__treatment=drug_A_B_control'
        }
    }
}
