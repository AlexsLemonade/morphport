nextflow_function {

    name "Test Function hasReferencePartition"
    script "../morphport.nf"
    tag "workflows"
    tag "workflows_morphport"

    test("hasReferencePartition: a group with a reference partition on one plate returns true") {

        function "hasReferencePartition"

        when {
            function {
                """
                input[0] = [
                    group_tag: 'well__treatments',
                    comparison_column: 'Metadata_treatment',
                    reference_column: 'Metadata_treatment',
                    reference_values: ['DMSO'],
                ]
                input[1] = [
                    [plate_id: 'p1', Metadata_treatment: 'drugA'],
                    [plate_id: 'p2', Metadata_treatment: 'drugA'],
                    [plate_id: 'p2', Metadata_treatment: 'DMSO'],
                ]
                """
            }
        }

        then {
            assert function.success
            assert function.result == true
        }
    }

    test("hasReferencePartition: a group with no reference partition returns false") {

        function "hasReferencePartition"

        when {
            function {
                """
                input[0] = [
                    group_tag: 'well__treatments',
                    comparison_column: 'Metadata_treatment',
                    reference_column: 'Metadata_treatment',
                    reference_values: ['DMSO', 'untreated'],
                ]
                input[1] = [
                    [plate_id: 'p1', Metadata_treatment: 'drugA'],
                    [plate_id: 'p2', Metadata_treatment: 'drugB'],
                ]
                """
            }
        }

        then {
            assert function.success
            assert function.result == false
        }
    }

    test("hasReferencePartition: a reference_column that differs from the comparison column is read") {

        function "hasReferencePartition"

        when {
            function {
                """
                input[0] = [
                    group_tag: 'well__cell_types_by_treatment',
                    comparison_column: 'Metadata_cell_type',
                    reference_column: 'Metadata_treatment',
                    reference_values: ['DMSO'],
                ]
                input[1] = [
                    // a cell type named like the reference value does not count
                    [plate_id: 'p1', Metadata_cell_type: 'DMSO', Metadata_treatment: 'drugA'],
                    [plate_id: 'p1', Metadata_cell_type: 'lineA', Metadata_treatment: 'DMSO'],
                ]
                """
            }
        }

        then {
            assert function.success
            assert function.result == true
        }
    }

    test("hasReferencePartition: non-string partition values match listed text values") {

        function "hasReferencePartition"

        when {
            function {
                """
                input[0] = [
                    group_tag: 'well__doses',
                    comparison_column: 'Metadata_dose',
                    reference_column: 'Metadata_dose',
                    reference_values: ['0'],
                ]
                input[1] = [
                    [plate_id: 'p1', Metadata_dose: 10],
                    [plate_id: 'p1', Metadata_dose: 0],
                ]
                """
            }
        }

        then {
            assert function.success
            assert function.result == true
        }
    }
}
